<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinFFmpeg.App.ConvertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinFFmpeg.App">

    <Grid
        AllowDrop="True"
        Background="Transparent"
        DragOver="OnDragOver"
        Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel MaxWidth="880" Margin="24,0,24,24" Spacing="4">

                <Grid>
                    <TextBlock
                        VerticalAlignment="Bottom"
                        Style="{StaticResource SectionHeaderStyle}"
                        Text="Files" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ClearButton" Click="OnClearClick" Content="Clear" />
                        <Button AutomationProperties.Name="Add files" Click="OnAddFilesClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                                <TextBlock Text="Add files" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Padding="4" Style="{StaticResource CardStyle}">
                    <Grid MinHeight="132">
                        <StackPanel
                            x:Name="EmptyState"
                            Padding="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6">
                            <FontIcon
                                FontSize="28"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE896;" />
                            <TextBlock HorizontalAlignment="Center" Text="Drop video, audio or image files here" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource CardDescriptionStyle}"
                                Text="You can also right-click files in Explorer and choose Convert with WinFFmpeg."
                                TextAlignment="Center" />
                        </StackPanel>

                        <ListView
                            x:Name="FilesList"
                            MaxHeight="212"
                            IsItemClickEnabled="False"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:FileItem">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontSize="16" Glyph="{x:Bind Glyph}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Style="{StaticResource CardDescriptionStyle}"
                                                Text="{x:Bind Folder}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="2"
                                            AutomationProperties.Name="Remove"
                                            Click="OnRemoveFileClick"
                                            Style="{StaticResource IconButtonStyle}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Remove">
                                            <FontIcon FontSize="12" Glyph="&#xE711;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Output" />

                <StackPanel x:Name="OptionsPanel" Spacing="4">
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Format" />
                                <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="The file type to convert to" />
                            </StackPanel>
                            <ComboBox
                                x:Name="FormatBox"
                                AutomationProperties.Name="Format"
                                Grid.Column="1"
                                MinWidth="220"
                                VerticalAlignment="Center"
                                SelectionChanged="OnFormatChanged" />
                        </Grid>
                    </Border>

                    <Border x:Name="VideoCodecRow" Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Video" />
                                <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="H.264 plays everywhere; HEVC and AV1 make smaller files" />
                            </StackPanel>
                            <ComboBox
                                x:Name="VideoCodecBox"
                                AutomationProperties.Name="Video"
                                Grid.Column="1"
                                MinWidth="220"
                                VerticalAlignment="Center"
                                SelectionChanged="OnCodecChanged" />
                        </Grid>
                    </Border>

                    <Border x:Name="AudioCodecRow" Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Audio" />
                                <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="The sound track of the video" />
                            </StackPanel>
                            <ComboBox
                                x:Name="AudioCodecBox"
                                AutomationProperties.Name="Audio"
                                Grid.Column="1"
                                MinWidth="220"
                                VerticalAlignment="Center"
                                SelectionChanged="OnCodecChanged" />
                        </Grid>
                    </Border>

                    <Border x:Name="QualityRow" Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Quality" />
                                <TextBlock
                                    x:Name="QualityLabel"
                                    Style="{StaticResource CardDescriptionStyle}"
                                    Text="Balanced" />
                            </StackPanel>
                            <Slider
                                x:Name="QualitySlider"
                                AutomationProperties.Name="Quality"
                                Grid.Column="1"
                                Width="220"
                                VerticalAlignment="Center"
                                IsThumbToolTipEnabled="False"
                                Maximum="5"
                                Minimum="1"
                                SnapsTo="StepValues"
                                StepFrequency="1"
                                TickFrequency="1"
                                TickPlacement="Outside"
                                ValueChanged="OnQualityChanged"
                                Value="3" />
                        </Grid>
                    </Border>

                    <Border x:Name="ResolutionRow" Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Resolution" />
                                <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="Larger sources are scaled down; smaller ones are left alone" />
                            </StackPanel>
                            <ComboBox
                                x:Name="ResolutionBox"
                                AutomationProperties.Name="Resolution"
                                Grid.Column="1"
                                MinWidth="220"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border x:Name="FrameRateRow" Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Frame rate" />
                                <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="Frames per second of the result" />
                            </StackPanel>
                            <ComboBox
                                x:Name="FrameRateBox"
                                AutomationProperties.Name="Frame rate"
                                Grid.Column="1"
                                MinWidth="220"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border x:Name="TrimRow" Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Trim" />
                                <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="Keep only part of each file, for example 0:30 to 1:45" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBox x:Name="TrimStartBox" Width="106" AutomationProperties.Name="Trim start" PlaceholderText="Start" />
                                <TextBox x:Name="TrimEndBox" Width="106" AutomationProperties.Name="Trim end" PlaceholderText="End" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid
            Grid.Row="1"
            Padding="24,12"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <InfoBar x:Name="Message" IsClosable="True" IsOpen="False" />

            <Button
                Grid.Row="1"
                AutomationProperties.Name="Settings"
                Click="OnSettingsClick"
                Style="{StaticResource IconButtonStyle}"
                Padding="10,6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                    <TextBlock Text="Settings" />
                </StackPanel>
            </Button>

            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button x:Name="SavePresetButton" Click="OnSavePresetClick" Content="Save as preset…" />
                <Button
                    x:Name="ConvertButton"
                    MinWidth="120"
                    Click="OnConvertClick"
                    Content="Convert"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
