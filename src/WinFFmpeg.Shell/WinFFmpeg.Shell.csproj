<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Explorer context menu handler. Published with Native AOT so the DLL is plain
    native code: Windows loads it into a COM surrogate on every right-click, and
    starting the .NET runtime there would make the menu visibly slow.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <DebuggerSupport>false</DebuggerSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinFFmpeg.Core\WinFFmpeg.Core.csproj" />
  </ItemGroup>

</Project>
