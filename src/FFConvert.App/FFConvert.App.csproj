<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>FFConvert.App</RootNamespace>
    <AssemblyName>FFConvert</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Ship .NET and the Windows App SDK inside the package, so it installs with no prerequisites. -->
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Precompiled code: the app is started by a right-click and should not spend that moment in the JIT. -->
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">true</PublishReadyToRun>
    <!-- Program.cs has the entry point: it decides between starting and handing over to a running instance. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- The context menu handler is a separate Native AOT publish; scripts\build.ps1 produces it first. -->
  <PropertyGroup>
    <ShellExtensionPath>$(MSBuildThisFileDirectory)..\..\artifacts\shell\FFConvert.Shell.dll</ShellExtensionPath>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(ShellExtensionPath)" Link="FFConvert.Shell.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireShellExtension" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(ShellExtensionPath)')"
           Text="FFConvert.Shell.dll has not been published. Run scripts\build.ps1, which builds it before the app." />
  </Target>

  <!--
    scripts\build.ps1 passes a copy of Package.appxmanifest with the package version
    filled in. Without it the manifest in this folder is picked up automatically.
  -->
  <ItemGroup Condition="'$(StampedPackageManifest)' != ''">
    <AppxManifest Include="$(StampedPackageManifest)">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FFConvert.Core\FFConvert.Core.csproj" />
  </ItemGroup>

</Project>
