<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FFConvert.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:FFConvert.Core">

    <ScrollViewer>
        <StackPanel MaxWidth="880" Margin="24,0,24,24" Spacing="4">

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="ffmpeg" />

            <InfoBar
                x:Name="MissingBar"
                Title="ffmpeg was not found"
                IsClosable="False"
                IsOpen="False"
                Message="FFConvert needs ffmpeg to convert anything. Install it, or point to an existing copy below."
                Severity="Warning">
                <InfoBar.ActionButton>
                    <Button Click="OnInstallClick" Content="Install with winget" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Location" />
                        <TextBlock x:Name="FfmpegStatus" Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button x:Name="FfmpegResetButton" Click="OnFfmpegResetClick" Content="Find automatically" />
                        <Button Click="OnFfmpegBrowseClick" Content="Browse…" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Use the graphics card for H.264 and HEVC" />
                        <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="Much faster, with somewhat larger files. Files the graphics card cannot encode are converted on the processor instead." />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="HardwareSwitch"
                        AutomationProperties.Name="Use the graphics card for H.264 and HEVC"
                        Grid.Column="1"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        OffContent=""
                        OnContent=""
                        Toggled="OnToggled" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Converted files" />

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Save to" />
                        <TextBlock x:Name="OutputStatus" Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button x:Name="OutputResetButton" Click="OnOutputResetClick" Content="Next to the original" />
                        <Button Click="OnOutputBrowseClick" Content="Choose folder…" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Notify me when conversions finish" />
                        <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="Shown when the progress window is not in front. Click the notification to open the folder." />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="NotifySwitch"
                        AutomationProperties.Name="Notify me when conversions finish"
                        Grid.Column="1"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        OffContent=""
                        OnContent=""
                        Toggled="OnToggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Close the progress window when done" />
                        <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="It stays open when a conversion fails, so you can see why." />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="CloseSwitch"
                        AutomationProperties.Name="Close the progress window when done"
                        Grid.Column="1"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        OffContent=""
                        OnContent=""
                        Toggled="OnToggled" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Your presets" />

            <Border x:Name="NoPresets" Style="{StaticResource CardStyle}">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CardDescriptionStyle}"
                    Text="Presets you save on the convert page appear here and in the right-click menu." />
            </Border>

            <ItemsRepeater x:Name="PresetList">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="core:Preset">
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Delete preset"
                                    Click="OnDeletePresetClick"
                                    Style="{StaticResource IconButtonStyle}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="Delete preset">
                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <TextBlock
                x:Name="About"
                Margin="2,20,0,0"
                Style="{StaticResource CardDescriptionStyle}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
